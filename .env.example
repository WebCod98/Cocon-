# Synchronisation entre les deux téléphones (facultatif).
#
# Sans ces deux variables, Cocon fonctionne exactement comme avant : les
# données restent sur l'appareil et se synchronisent seulement entre les
# onglets d'un même navigateur.
#
# Avec elles, les deux partenaires partagent réellement le même Cocon.
# Où les trouver : Supabase → votre projet → Settings → API.
# Voir DEPLOIEMENT.md pour la marche à suivre complète.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
